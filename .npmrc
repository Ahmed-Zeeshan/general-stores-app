# Exact versions are pinned in package.json / package-lock.json and the app is tested with them.
# npm's install-time audit suggests "npm audit fix --force", which installs breaking major
# versions (it replaced Tailwind 3 with 4 and broke the styles). The only remaining advisory is
# in Next.js's ESLint plugin (a developer tool, no fixed version exists). Run `npm audit`
# yourself any time; production dependencies report 0 vulnerabilities (`npm audit --omit=dev`).
audit=false
fund=false
