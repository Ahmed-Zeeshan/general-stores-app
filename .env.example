# MongoDB connection string. Local MongoDB (default port) — see README "Local MongoDB".
MONGODB_URI=mongodb://127.0.0.1:27017/dukaan

# REQUIRED: your own long random value used to sign logins and WhatsApp links (at least 32 characters).
# The app refuses to log anyone in until it is set. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret: anyone who knows it can make themselves a login.
AUTH_SECRET=

# Optional: on a server reachable from the internet, set this so only you can create the admin account
# on first run (the setup page asks for it). Not needed on a shop computer.
# SETUP_TOKEN=

# Time zone used for "today", daily reports and receipts
TZ=Asia/Karachi

# Optional: override FBR POS endpoints (defaults are FBR's published sandbox and live URLs)
# FBR_SANDBOX_URL=https://esp.fbr.gov.pk:8244/FBR/v1/api/Live/PostData
# FBR_LIVE_URL=https://gw.fbr.gov.pk/imsp/v1/api/Live/PostData

# Optional: automatic nightly backups of every shop (see README "Production")
# AUTO_BACKUP=off
# AUTO_BACKUP_TIME=22:30
# AUTO_BACKUP_KEEP=30
# BACKUP_DIR=./backups

# Optional: npm run start:https ports and your own certificate
# PORT=3000
# HTTPS_PORT=3443
# HTTPS_KEY=certs/my.key
# HTTPS_CERT=certs/my.crt
